# Modello di linguaggio: "ollama" (locale, gratuito) oppure "openai" (a pagamento)
LLM_PROVIDER="ollama"

# Ollama (https://ollama.com) - modello locale
OLLAMA_MODEL="qwen3:8b"
OLLAMA_NUM_CTX="8192"

# OpenAI - necessario solo con LLM_PROVIDER="openai"
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4o"

# SerpApi (https://serpapi.com) - ricerca voli e hotel
SERPAPI_API_KEY="YOUR_SERPAPI_API_KEY"
